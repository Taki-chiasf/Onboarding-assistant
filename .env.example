# Copy this file to .env (gitignored) or export these via direnv (.envrc).
# Values here are placeholders only — never commit real secrets.

# Mistral La Plateforme API key
MISTRAL_API_KEY=

# Postgres (app schema + read-only data schema; pgvector + pg_trgm enabled)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/onboarding_assistant

# Redis (queue)
REDIS_URL=redis://localhost:6379/0

# OpenTelemetry OTLP endpoint (HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

LOG_LEVEL=INFO

# Mock auth mode: 0=off, 1=static dev principal, 2=persona picker (demo)
MOCK_OIDC=1

# Static principal used when MOCK_OIDC=1
DEV_PRINCIPAL_SUB=dev-user
DEV_PRINCIPAL_EMAIL=dev@example.com
DEV_PRINCIPAL_DEPT=Engineering
DEV_PRINCIPAL_ROLE=employee
