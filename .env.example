# Copy this file to .env (gitignored) or export these via direnv (.envrc).
# Values here are placeholders only — never commit real secrets.

# Mistral La Plateforme API key
MISTRAL_API_KEY=

# Intent router provider: "mistral" (hosted small model) or "ollama" (local open weights)
LLM_PROVIDER=mistral
OLLAMA_BASE_URL=http://localhost:11434

# Postgres (app schema + read-only data schema; pgvector + pg_trgm enabled)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/onboarding_assistant

# Optional: PgBouncer transaction-pooling proxy (compose `pgbouncer` service).
# Used by the read-only query layer and the RLS canary test.
# PGBOUNCER_URL=postgresql+psycopg://app:app@localhost:6432/onboarding_assistant

# Redis (queue)
REDIS_URL=redis://localhost:6379/0

# OpenTelemetry OTLP endpoint (HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

LOG_LEVEL=INFO

# Mock auth mode: 0=off, 1=static dev principal, 2=persona picker (default demo)
# With a real OIDC issuer + client id set, the SSO flow takes precedence.
MOCK_OIDC=2

# Real OIDC (production auth path). Leave blank for the demo persona picker.
# OIDC_ISSUER must match the id token's `iss` claim exactly. Custom claim names
# are namespaced in Auth0, e.g. https://<tenant>.auth0.com/dept.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
OIDC_AUTHORIZE_URL=
OIDC_TOKEN_URL=
OIDC_JWKS_URL=
OIDC_DEPT_CLAIM=dept
OIDC_ROLE_CLAIM=role
OIDC_EMAIL_CLAIM=email
# Comma-separated allowlists. An empty department list accepts any non-empty
# department; a role outside the list degrades to least privilege.
OIDC_ALLOWED_DEPARTMENTS=
OIDC_ALLOWED_ROLES=employee,admin

# Static principal used when MOCK_OIDC=1
DEV_PRINCIPAL_SUB=dev-user
DEV_PRINCIPAL_EMAIL=dev@example.com
DEV_PRINCIPAL_DEPT=Engineering
DEV_PRINCIPAL_ROLE=employee

# Per-user daily token budget (tokens in + out, summed across models). The
# request that would reach the cap is rejected; 0 disables the cap.
DAILY_TOKEN_BUDGET=200000

# Runaway-spend alert threshold in USD. Raises a warning and a metric; it never
# blocks. 0 disables the alert.
DAILY_COST_ALERT_USD=1.0

# Moderation screen over user input and ingested content. It never blocks; it
# flags abuse/personal data for the redaction layer and observability.
MODERATION_ENABLED=true

# Retention window for query audit logs and eval records, in days.
RETENTION_DAYS=90

# Incoming-webhook URL for the nightly eval alert (Slack-compatible payload).
# Leave empty to run the nightly silently.
SLACK_EVAL_WEBHOOK_URL=

# Trace backend (Tempo HTTP API) for the admin console's span viewer.
# Set when running the observability profile, e.g. http://localhost:3200.
TEMPO_URL=
